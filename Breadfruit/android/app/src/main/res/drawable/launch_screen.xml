    <!-- Centered splash logo -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splashscreen_logo"
            android:antialias="true"
            android:filter="true"
            android:tileMode="disabled" />
    </item>

</layer-list>
